{"key": "814f603012fc53f9", "role": "operator", "t": 1790984543.726, "seconds": 6.814, "output": "import sys\nimport json\nimport re\n\ndef extract_values(line):\n    line = line.strip()\n    # Try to parse as JSON\n    try:\n        obj = json.loads(line)\n        if isinstance(obj, dict):\n            typ = obj.get(\"TYPE\", \"\")\n            desc = obj.get(\"DescriptionOfwork\", \"\")\n            return typ, desc\n    except:\n        pass\n    return line, None\n\ndef main():\n    data = sys.stdin.read().strip().splitlines()\n    if not data:\n        return\n\n    # If the input is a single JSON object containing both fields\n    if len(data) == 1:\n        try:\n            obj = json.loads(data[0])\n            typ = obj.get(\"TYPE\", \"\")\n            desc = obj.get(\"DescriptionOfwork\", \"\")\n        except:\n            typ = data[0]\n            desc = \"\"\n    else:\n        # First line TYPE, second line DescriptionOfwork (or both JSON)\n        typ_line, desc_line = data[0], data[1] if len(data) > 1 else \"\"\n        typ, _ = extract_values(typ_line)\n        _, desc = extract_values(desc_line)\n        if desc is None:  # second line wasn't JSON, treat as raw description\n            desc = desc_line\n\n    typ = typ.strip().lower()\n    desc = desc.strip().lower()\n\n    # Determine if they refer to the same feature:\n    # 1) Exact match\n    # 2) TYPE appears as a whole word in DescriptionOfwork\n    match = 0\n    if typ and desc:\n        if typ == desc:\n            match = 1\n        else:\n            # Use word boundaries to avoid partial matches\n            pattern = r'\\b' + re.escape(typ) + r'\\b'\n            if re.search(pattern, desc):\n                match = 1\n\n    print(match)\n\nif __name__ == \"__main__\":\n    main()\n"}
