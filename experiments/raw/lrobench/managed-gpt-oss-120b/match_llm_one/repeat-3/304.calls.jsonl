{"key": "3f9e1b8eba67f2eb", "role": "operator", "t": 1790977566.339, "seconds": 9.332, "output": "import sys, json, re\n\ndef extract_values(text):\n    # Try to parse as JSON objects (could be separate lines or a single combined JSON)\n    try:\n        # If the whole text is a JSON array or object containing both keys\n        data = json.loads(text)\n        if isinstance(data, dict):\n            return data.get(\"TYPE\", \"\"), data.get(\"URL\", \"\")\n        if isinstance(data, list):\n            typ = url = \"\"\n            for item in data:\n                if isinstance(item, dict):\n                    if \"TYPE\" in item:\n                        typ = item[\"TYPE\"]\n                    if \"URL\" in item:\n                        url = item[\"URL\"]\n            return typ, url\n    except:\n        pass\n\n    # Fallback: look for key-value patterns\n    typ_match = re.search(r'\"TYPE\"\\s*:\\s*\"([^\"]*)\"', text)\n    url_match = re.search(r'\"URL\"\\s*:\\s*\"([^\"]*)\"', text)\n    if typ_match and url_match:\n        return typ_match.group(1), url_match.group(1)\n\n    # Fallback: treat each line as raw values\n    lines = [line.strip() for line in text.strip().splitlines() if line.strip()]\n    if len(lines) >= 2:\n        return lines[0], lines[1]\n    return \"\", \"\"\n\ndef same_feature(typ, url):\n    if not typ or not url:\n        return 0\n    return 1 if typ.lower() in url.lower() else 0\n\ndef main():\n    input_text = sys.stdin.read()\n    typ, url = extract_values(input_text)\n    result = same_feature(typ, url)\n    sys.stdout.write(str(result))\n\nif __name__ == \"__main__\":\n    main()\n"}
